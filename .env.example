# Copy to .env.local and fill in real values.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The real CareConnect API. Anything already migrated talks to this.
API_BASE_URL=https://careconnect-api-sb5u.onrender.com/api/v1

# TEMPORARY. Our own stub endpoints, for the features not migrated yet.
# Deleted, along with src/app/api, once everything points at API_BASE_URL.
STUB_BASE_URL=http://localhost:3000/api

# OPTIONAL. The API's own JWT signing secret.
# The API signs the session token, so without this we can only decode it, not
# verify the signature. Decoding is enough for deciding what to show, because
# the API rejects forged tokens itself. Set this if the API team shares it and
# the signature gets checked here too.
# API_JWT_SECRET=
